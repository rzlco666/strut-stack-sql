# Copy to .env for local development with docker-compose

# PostgreSQL (default)
DATABASE_URL=postgresql://demo:demo@localhost:5433/demo

# MySQL (uncomment to switch)
# DATABASE_URL=mysql://demo:demo@localhost:3307/demo

# Optional: multi-source TOML instead of a single URL.
# There is no MCP_SQL_CONFIG env var — pass the file with the CLI flag:
#   strut-stack-sql --config ./strut-stack-sql.toml
# (example file: strut-stack-sql.example.toml)

# HTTP mode (only used with --http):
# API tokens: comma-separated entries 'name:token:mode[:source1|source2]'
# where mode is the token's maximum write mode: readonly | writes | ddl.
# Token secrets must not contain ':' or ','.
# Binding a non-loopback address without tokens is refused at startup.
# STRUT_STACK_SQL_HTTP_TOKENS=alice:change-me-1:readonly,bob:change-me-2:writes

# Ephemeral mode: when no database is configured the server falls back to
# in-memory SQLite with a LOUD startup banner (never silent). Set this to
# acknowledge the mode explicitly — first-run trials only, never real work.
# STRUT_STACK_SQL_EPHEMERAL=1
# (CLI equivalent: --ephemeral)

# Logging (stderr only — never log full DSNs in production)
# MCP_SQL_LOG=info
# Audit trail of executed SQL (statement text only, no parameter values):
# MCP_SQL_LOG=audit=info
